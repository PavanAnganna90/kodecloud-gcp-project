# Copy to config.env and edit. Cloud Build trigger substitutions should match.

# --- App ---
APP_NAME=gcpdevops
CONTAINER_PORT=5000

# --- Artifact Registry ---
# Terraform creates the repo; keep AR_REPO equal to artifact_registry_repo
# and AR_REGION equal to region in infra/terraform/terraform.tfvars.
AR_REGION=us-central1
AR_REPO=gcp-artifact-registry

# --- GKE deploy target ---
# The namespace is created by the Kustomize overlay, so it need not exist yet.
GKE_CLUSTER=gke-retail-dev
GKE_LOCATION=us-central1-a
K8S_NAMESPACE=gcp-kodecloud-prod-namespace

# --- Kustomize overlay used by CI ---
KUSTOMIZE_OVERLAY=deploy/k8s/overlays/default
